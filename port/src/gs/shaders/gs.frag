#version 450
// GS primitive, fragment stage: texture function (TEX0.TFX / TCC) and alpha test (TEST), as the GS does them.
// Colours are 0..1 for 0..255. Alpha is carried with 1.0 = 0x80 (the GS's "opaque").
layout(location = 0) in vec4 vColor;
layout(location = 1) in vec3 vStq;
layout(location = 0) out vec4 outColor;
layout(location = 1) out vec4 outAux; // .r: the alpha byte exactly as the GS stores it (object numbers live there)
#ifndef NO_FRAG_DEPTH // (gsnz.frag, generated by the build: this shader without its own depth, see the end)
layout(depth_less) out float gl_FragDepth; // (only ever made smaller: the early depth test stays valid)
#endif
layout(set = 2, binding = 0) uniform sampler2D tex;
layout(set = 2, binding = 1) uniform sampler2D dateTex; // a copy of the target's alpha bytes, for the destination alpha test
layout(set = 3, binding = 0) uniform Params {
    ivec4 mode;  // x: textured (1 from GS memory, 2 a frame buffer, 3 a texture pack's replacement), y: TFX, z: TCC, w: alpha test (0 off, else ATST + 1)
    vec4 misc;   // x: AREF in GS units (0..255); y: destination alpha test (0 off, 1 pass where bit 7 of the
                 // stored alpha is 0, 2 where it is 1); z: 1 = FBA, the alpha written gets bit 7 set;
                 // w: for 2D sprites, output pixels per GS pixel (0 = sample per output pixel; negative: a
                 // texture pack's replacement, see below)
    vec4 rect;   // textured from a frame buffer (mode.x == 2): the uv range that may be sampled
    vec4 orig;   // a texture pack's replacement: xy = the original texture's size (2D art, misc.w < 0);
                 // z = the original's largest alpha
    vec4 extra;  // x: the depth buffer's largest value (0xFFFFFF for 24 bits); y: 1 = the colour is scaled by
                 // its alpha here and blended with factor one (an alpha above 0x80: gs_draw.c, blend_key)
} p;
// 1.0 where v is not negative
vec2 step2(vec2 v) { return vec2(v.x >= 0.0 ? 1.0 : 0.0, v.y >= 0.0 ? 1.0 : 0.0); }

// The sphere effect (anime_esfera.txt, 12-nov-2026): a colour 0xRRGGBB kept as a whole number in a float
vec3 esf_rgb(float v) {
    float r = floor(v / 65536.0), g = floor((v - r * 65536.0) / 256.0);
    return vec3(r, g, v - r * 65536.0 - g * 256.0) / 255.0;
}
// how much of a band of radius r0..r1 round c (in the 64 x 64 texels of Syn / Omega Shenron's reflection, aab98431)
float esf_band(vec2 q, vec2 c, float r0, float r1, float aa) {
    float d = length(q - c);
    return (1.0 - smoothstep(r1 - aa, r1 + aa, d)) * smoothstep(r0 - aa, r0 + aa, d);
}
// The shine: the two shapes of that reflection, measured off it (a ball with a tail curling up on the right, a crescent
// with a bulb on the left), at uv = where the surface faces the camera (vu0.vert esfera_refl). 0..1.
float esf_shape(vec2 uv, float aa) {
    vec2 q = vec2(uv.x, 1.0 - uv.y) * 64.0;
    float m = 1.0 - smoothstep(10.5 - aa, 10.5 + aa, length(q - vec2(44.0, 34.0)));        // the ball
    vec2 t = q - vec2(44.0, 34.0);
    float a = degrees(atan(t.y, t.x));                                                     // (y down: -90 = up)
    float f = clamp((a + 95.0) / 70.0, 0.0, 1.0), r = mix(19.5, 12.5, f);                 // its tail, -95..-25 degrees
    float tail = (a > -97.0 && a < -22.0) ? esf_band(q, vec2(44.0, 34.0), r - 1.8, r + 1.8, aa) : 0.0;
    m = max(m, tail);
    m = max(m, 1.0 - smoothstep(7.0 - aa, 7.0 + aa, length(q - vec2(15.5, 22.0))));       // the crescent's bulb
    vec2 s = q - vec2(32.9, 30.6);
    float b = degrees(atan(s.y, s.x));
    if (b < 0.0) b += 360.0;                                                               // 52 (the tip) .. 206 (the bulb)
    float th = mix(1.8, 2.6, smoothstep(52.0, 80.0, b));                                   // (thinner towards the tip)
    float cres = (b > 50.0 && b < 208.0) ? esf_band(q, vec2(32.9, 30.6), 22.0 - th, 22.0 + th, aa) : 0.0;
    return max(m, cres);
}

#ifdef GS_BLOCK
// A work buffer read as the GS reads it at 1x (mode.x == 2, orig.x = output texels per GS texel): the bilinear
// filter between whole GS texels, each the average of its block, taken by four filtered reads a quarter of a GS
// texel from its middle. Held inside rect by the middles of the edge GS texels, as the GS's CLAMP holds it.
// Only in gswb.frag (this file with GS_BLOCK, key bit 25), for those draws alone, and only between work buffers
// (gs_draw.c): the sixteen reads are not spent on the shader of every draw, nor on every pixel of the picture.
vec4 gs_block(vec2 c, vec2 g) {
    c = clamp(c, p.rect.xy, p.rect.zw);
    if (p.orig.x < 2.5) return texture(tex, c); // (at 2x the block is 2 x 2: one filtered read at its middle is its average)
    vec2 q = 0.25 / g;
    return 0.25 * (texture(tex, c + vec2(-q.x, -q.y)) + texture(tex, c + vec2(q.x, -q.y)) +
                   texture(tex, c + vec2(-q.x, q.y)) + texture(tex, c + vec2(q.x, q.y)));
}
vec4 gs_bilinear(vec2 uv) {
    vec2 g = vec2(textureSize(tex, 0)) / p.orig.x; // GS texels across the whole texture
    vec2 at = uv * g - 0.5, i = floor(at), f = at - i;
    vec2 c = (i + 0.5) / g, d = 1.0 / g;
    return mix(mix(gs_block(c, g), gs_block(c + vec2(d.x, 0.0), g), f.x),
               mix(gs_block(c + vec2(0.0, d.y), g), gs_block(c + d, g), f.x), f.y);
}
#endif

void main() {
    float k = 255.0 / 128.0;
    if (p.misc.y != 0.0) {
        // TEST.DATE: the GS looks at bit 7 of the alpha already in the frame buffer. A GPU cannot read what it is
        // drawing to, so the back end hands over a copy made just before this run of draws.
        bool set = texelFetch(dateTex, ivec2(gl_FragCoord.xy), 0).r >= 127.5 / 255.0;
        if (set != (p.misc.y > 1.5)) discard;
    }
    vec3 rgb = vColor.rgb;
    float a = vColor.a * k;
    float portraitFade = 1.0;
    if (p.mode.x == 4) {
        // The anime pass (gs_draw.c, vu0.vert layer 7): the texture is twice the model texture's height, its colours
        // in the light on top, in the shadow below (gs_texpack.h); or three times, a middle tone between them. vColor.r: where this point is on the shading ramp;
        // misc.x: the ramp's edge there, orig.x: 1 if the light is past it, -1 if before. orig.y: 1 = clamped in v.
        // rect.y: the tones in the texture, its blocks (2: lit, shadow; 3: lit, middle, shadow, the middle one
        // rect.x either side of the edge)
        float s = (vColor.r - p.misc.x) * p.orig.x;
        float blocks = clamp(floor(p.rect.y + 0.5), 2.0, 5.0);
        float block = blocks > 2.5 ? (s >= p.rect.x ? 0.0 : s >= -p.rect.x ? 1.0 : 2.0) : (s >= 0.0 ? 0.0 : 1.0);
        if (blocks > 3.5) {
            // 4 or 5 tones (anime_capas.txt, 12-nov-2026): rect.x = 1000000 + w1 * 10000 + w2 * 100 + w3, the middle tones'
            // widths in percent of the ramp from the lit side, together centred on the edge
            float wv = p.rect.x - 1000000.0;
            float w1 = floor(wv / 10000.0), w2 = floor((wv - w1 * 10000.0) / 100.0), w3 = wv - w1 * 10000.0 - w2 * 100.0;
            float b0 = (w1 + w2 + w3) / 200.0, b1 = b0 - w1 / 100.0, b2 = b1 - w2 / 100.0, b3 = b2 - w3 / 100.0;
            block = s >= b0 ? 0.0 : s >= b1 ? 1.0 : s >= b2 ? 2.0 : (blocks > 4.5 && s >= b3) ? 3.0 : blocks - 1.0;
        }
        vec2 uv = vStq.xy / vStq.z;
        float h = 0.5 / float(textureSize(tex, 0).y);
        float v = p.orig.y > 0.5 ? clamp(uv.y, 0.0, 1.0) : fract(uv.y);
        // (Rev22, 13-nov-2026) extra.z > 0: one more block after the tones holds the lines inside the piece (gs_draw.c
        // anime_lines_make: R, G = the way from the line's middle, B = half its width), and the tone
        // blocks have the colour round each line where it was. The line is drawn here black, as wide as it was but never
        // wider than the outline (extra.z: its width in pixels of the picture), sharp however much the texture is
        // stretched (the edge one pixel soft, from how many texels a pixel covers).
        // (Rev24) with lines (extra.z > 0): the tones twice, as the file has them and with the lines painted over, then the
        // line block (gs_draw.c anime_lines_make: 2 * blocks + 1)
        // (Rev30) and after it the distance block: 2 * blocks + 2
        float lineBlk = p.extra.z > 0.0 ? 1.0 : 0.0, tot = lineBlk > 0.5 ? 2.0 * blocks + 2.0 : blocks;
        vec2 tcl = uv * vec2(textureSize(tex, 0)) * vec2(1.0, 1.0 / tot);
        float tpx = max(length(dFdx(tcl)), length(dFdy(tcl))); // texels of the piece per pixel of the picture
        float vb = clamp(v / tot, h, 1.0 / tot - h);
        vec4 t = texture(tex, vec2(uv.x, vb + block / tot));
#ifndef NO_LINES // (d3d9_shaders.py: Shader Model 3 has no integer bits nor texelFetch; there the lines stay as the file has them)
        if (lineBlk > 0.5 && p.extra.z < 999.0) { // (1000: not known yet: the file as it is)
            // (Rev24) The widest a line is drawn is a width on the model (extra.z: in uv of this texture, gs_draw.c
            // anime_lines_cap / anime_density), the same as the lines of Goku SSJ2's face; (Rev26) and never wider than the
            // outline is on the screen (|extra.w|, pixels of the picture): close up the outline's width, far away the face's
            // lines', and thinner than a pixel a line is drawn a pixel wide but as much lighter (as the face's lines fade).
            // A line no wider than that is left as the file has it (the tones as they are); round a wider one the tones with
            // the lines painted over are taken, and the lines there are drawn again: the line block's skeleton points round
            // this pixel (3 x 3 texels; G > 0), each at its texel's middle moved by B, A (-1..1 texels, the line's real middle,
            // straightened), joined by a segment to each neighbour R marks (a bit each: E, W, S, N, SE, NE, SW, NW), black as
            // far as half its width there (G * 4 texels) from those segments, at most half the cap. A point painted over that
            // is no skeleton point: B = half the width of its line. G = 1: a line added between two colours (Rev26), always
            // drawn at the cap. On a face (extra.w < 0) the file's own lines are never drawn again, only the added ones.
            // A = 1 on a texel that is no skeleton point: something within a texel; 0 there and nothing else: no line near.
            // (Rev30, 13-nov-2026) Every line black and as wide on the screen as the outline (|extra.w|, pixels of the picture),
            // at any distance (the user: far away the lines faded to a darker shade of the colour round them, close up some
            // were thicker; "todas las lineas, incluidas las de la cara, igual de lejos que de cerca"). Black up to a quarter
            // pixel short of that half width, soft over the next pixel (the clean line the user showed: no saw teeth). Far
            // away (a pixel over a texel or more) the distance to the nearest line comes from the distance block, read
            // between its texels (gs_draw.c anime_lines_make: R = 1/30 texel, G = the line's G); close up, exactly, from
            // the skeleton's segments round this pixel (3 x 3 texels: points at B, A, joined to the neighbours R marks).
            // A line marked thicker (G 192..254, anime_lineas_gruesas.txt) grows up to orig.w times that close up, never past
            // its own width in the file: as thin as the rest far away. Off a face the tones with the lines painted over are
            // shown under the lines (each line only as drawn here); on a face (extra.w < 0) the file as it is, the lines
            // drawn over it (where the file's are thinner than this, far away: they never fade nor break).
            ivec2 tsz = textureSize(tex, 0);
            int bh = tsz.y / int(tot + 0.5), base = int(2.0 * blocks + 0.5) * bh, sbase = base + bh;
            vec2 pt = vec2(fract(uv.x) * float(tsz.x), v * float(bh));
            ivec2 c0 = ivec2(floor(pt));
            bool faceT = p.extra.w < 0.0;
            float hhW = min(0.5 * abs(p.extra.w) * tpx, 6.0);
            // (tenk6, 14-nov-2026) every line grows close up as the marked ones did (the user: "que se vea con ese grosor
            // cuando te acercas"): its own width in the file, never thinner than the line far away nor wider than kAll
            // times it; the marked ones (Majin Vegeta's M) up to kThick. orig.w = 100 * kAll + kThick (gs_draw.c,
            // textures/anime_lineas_cerca.txt: 2 and 4)
            float kAll = p.rect.z > 0.5 ? 2.0 : max(floor(p.orig.w / 100.0), 1.0);
            float kThick = p.rect.z > 0.5 ? 2.0 : max(p.orig.w - 100.0 * floor(p.orig.w / 100.0), 1.0);
            // (Rev31) soft half a pixel either side of the width (anime_lineas_grosor.txt, extra.w): Rev30's edge, black to a
            // quarter pixel short and soft for 3/4 beyond, with the outline's width, came out about 3 pixels of the screen
            float a0 = 0.5 * tpx, a1 = 0.5 * tpx, ink = 0.0, bestD = 1e6;
            vec2 bestCp = pt;
            if (tpx >= 1.0) {
                vec2 sp0 = pt - 0.5;
                ivec2 i0 = ivec2(floor(sp0));
                vec2 fr = sp0 - vec2(i0);
                float dS = 0.0, dMin = 1e6, gS = 0.0;
                for (int j = 0; j < 4; j++) {
                    ivec2 qq = i0 + ivec2(j & 1, j >> 1);
                    qq.x = (qq.x % tsz.x + tsz.x) % tsz.x;
                    qq.y = p.orig.y > 0.5 ? clamp(qq.y, 0, bh - 1) : (qq.y % bh + bh) % bh;
                    vec4 sd = texelFetch(tex, ivec2(qq.x, qq.y + sbase), 0);
                    float dj = sd.r * 255.0 / 30.0;
                    dS += dj * ((j & 1) == 1 ? fr.x : 1.0 - fr.x) * ((j >> 1) == 1 ? fr.y : 1.0 - fr.y);
                    if (dj < dMin) { dMin = dj; gS = sd.g; }
                }
                if (gS > 0.0) {
                    float g255S = gS * 255.0;
                    float hhS = g255S > 191.5 && g255S < 254.5 ? clamp((g255S - 192.0) / 62.0 * 3.0, hhW, kThick * hhW)
                              : g255S < 191.5 ? clamp(gS * 4.0, hhW, kAll * hhW) : hhW;
                    ink = 1.0 - smoothstep(hhS - a0, hhS + a1, dS);
                }
            } else {
                vec4 s0 = texelFetch(tex, ivec2((c0.x % tsz.x + tsz.x) % tsz.x, clamp(c0.y, 0, bh - 1) + sbase), 0);
                if (s0.r * 255.0 / 30.0 < 3.0) {
                    const ivec2 nb[8] = ivec2[8](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1), ivec2(1, 1), ivec2(1, -1), ivec2(-1, 1), ivec2(-1, -1));
                    for (int dy = -1; dy <= 1; dy++) {
                        for (int dx = -1; dx <= 1; dx++) {
                            ivec2 cc = c0 + ivec2(dx, dy), qq = cc;
                            qq.x = (qq.x % tsz.x + tsz.x) % tsz.x;
                            qq.y = p.orig.y > 0.5 ? clamp(qq.y, 0, bh - 1) : (qq.y % bh + bh) % bh;
                            vec4 sk = texelFetch(tex, ivec2(qq.x, qq.y + base), 0);
                            if (sk.g <= 0.0) continue;
                            float g255 = sk.g * 255.0;
                            bool added = g255 > 254.5, thick = !added && g255 > 191.5;
                            float hh = thick ? clamp((g255 - 192.0) / 62.0 * 3.0, hhW, kThick * hhW)
                                     : added ? hhW : clamp(sk.g * 4.0, hhW, kAll * hhW);
                            vec2 pa = vec2(cc) + 0.5 + (sk.ba - 0.5) * 2.0;
                            float dist = length(pt - pa);
                            vec2 cp = pa;
                            int bits = int(sk.r * 255.0 + 0.5);
                            for (int k = 0; k < 8; k++) {
                                if ((bits & (1 << k)) == 0) continue;
                                ivec2 cn = cc + nb[k], qn = cn;
                                qn.x = (qn.x % tsz.x + tsz.x) % tsz.x;
                                qn.y = p.orig.y > 0.5 ? clamp(qn.y, 0, bh - 1) : (qn.y % bh + bh) % bh;
                                vec4 sn = texelFetch(tex, ivec2(qn.x, qn.y + base), 0);
                                vec2 pb = vec2(cn) + 0.5 + (sn.ba - 0.5) * 2.0, e = pb - pa;
                                float tt = clamp(dot(pt - pa, e) / max(dot(e, e), 1e-4), 0.0, 1.0);
                                float dd = length(pt - pa - tt * e);
                                if (dd < dist) { dist = dd; cp = pa + tt * e; }
                            }
                            ink = max(ink, 1.0 - smoothstep(hh - a0, hh + a1, dist));
                            if (!added && dist < bestD) { bestD = dist; bestCp = cp; }
                        }
                    }
                }
            }
            if (!faceT) {
                // (the alpha stays the file's: where it leaves the shading to the game, the game's, as in Rev21)
                vec3 base3 = texture(tex, vec2(uv.x, vb + (blocks + block) / tot)).rgb;
                if (bestD < 1.0 && bestD > 1e-3) {
                    // (Rev29) within a texel of the line: the colour of this side a texel off the line, along the line's
                    // own smooth course (the texture's stair of texels beside a thin line: saw teeth)
                    vec2 sp = bestCp + (pt - bestCp) / bestD * 1.0;
                    float su = sp.x / float(tsz.x), sv = sp.y / float(bh);
                    sv = p.orig.y > 0.5 ? clamp(sv, 0.0, 1.0) : fract(sv);
                    base3 = texture(tex, vec2(su, clamp(sv / tot, h, 1.0 / tot - h) + (blocks + block) / tot)).rgb;
                }
                t.rgb = mix(base3, vec3(0.0), ink);
            } else if (ink > 0.0) {
                // (Rev31) a face: black only where its file has the line (as dark there against the tones with the lines
                // painted over): the file's own shape, never wider (the user: Rev30's faces deformed by lines drawn over
                // them; Rev21's, the file as it is, were right), its lines black at the width or thinner
                vec3 clean = texture(tex, vec2(uv.x, vb + (blocks + block) / tot)).rgb;
                float lc = dot(clean, vec3(0.299, 0.587, 0.114)), lt = dot(t.rgb, vec3(0.299, 0.587, 0.114));
                float lineness = lc > 0.03 ? clamp((1.0 - lt / lc) * 2.5, 0.0, 1.0) : 0.0;
                t.rgb = mix(t.rgb, vec3(0.0), ink * lineness);
            }
        }
#endif
#ifndef NO_LINES // (Shader Model 3 has no texelFetch)
        if (p.rect.w < -0.5 && p.rect.z < 0.5) {
            // (tenk4, anime_brillo.txt) the gloss's reflection map in grey: dark, middle and light colour by its grey in this
            // pixel (thresholds 16 and 96 of 255), the edges smooth over a pixel; the colours: the next block's first texels
            ivec2 tsz2 = textureSize(tex, 0);
            int bh2 = tsz2.y / int(tot + 0.5);
            vec3 cD = texelFetch(tex, ivec2(0, bh2), 0).rgb, cM = texelFetch(tex, ivec2(1, bh2), 0).rgb, cL = texelFetch(tex, ivec2(2, bh2), 0).rgb;
            float g = dot(t.rgb, vec3(0.299, 0.587, 0.114));
            float aa = max(fwidth(g), 0.004);
            float m1 = smoothstep(16.0 / 255.0 - aa, 16.0 / 255.0 + aa, g), m2 = smoothstep(96.0 / 255.0 - aa, 96.0 / 255.0 + aa, g);
            t.rgb = mix(mix(cD, cM, m1), cL, m2);
            t.a = 1.0;
        }
#endif
        if (t.a < 0.5) discard; // (the game's own shading kept there)
        // The game outlines a model by drawing it a second time inside out, behind it: those triangles face the other
        // way on the screen, and they are the line round every lock of hair (the outline pass only draws lines between
        // parts, and a head of hair is one part). Left as the game drew them, on every model (orig.z: 1 = the shell is
        // what faces away, 2 = what faces this way, gs_draw.c anime_shell; 0 = drawn over).
        if ((p.orig.z > 0.5 && p.orig.z < 1.5 && !gl_FrontFacing) || (p.orig.z > 1.5 && gl_FrontFacing)) discard;
        if (p.rect.z > 0.5) {
            // The sphere effect (gs_draw.c: rect.z = dark + 1, rect.w = light): the texels in the dark colour show the
            // two-shape shine in the light one; vColor.b / a carry where the surface faces (vu0.vert), the alpha is orig.w.
            vec3 osc = esf_rgb(p.rect.z - 1.0);
            if (all(lessThan(abs(t.rgb - osc), vec3(1.5 / 255.0)))) {
                vec2 ruv = vec2(vColor.b, vColor.a);
                float aa = clamp(length(fwidth(ruv)) * 64.0, 0.35, 2.0);
                t.rgb = mix(osc, esf_rgb(p.rect.w), esf_shape(ruv, aa));
            }
            rgb = t.rgb * vColor.g * k;
            a = p.orig.w * k;
        } else {
            rgb = t.rgb * vColor.g * k;
            a = vColor.a * k;
        }
    } else if (p.mode.x != 0) {
        vec2 uv = vStq.xy / vStq.z;
        if (p.misc.w != 0.0) {
            // A 2D sprite: take the texture coordinate where the GS takes it, at the whole GS pixel this fragment
            // belongs to (misc.w = output pixels per GS pixel). Every output pixel of that GS pixel then shows
            // the same texel, as on the console. Sampling at the output pixels' own centres reaches a quarter or
            // three quarters of a texel further, and at a sprite's edge that is the neighbouring picture of the
            // sheet (seen as slivers of another bar's colour and as thin lines along HUD panels).
            float s = abs(p.misc.w);
            vec2 f = gl_FragCoord.xy, g = floor(f / s) * s;
            vec2 dx = dFdx(uv), dy = dFdy(uv);
            vec2 at = uv - (dx * (f.x - g.x) + dy * (f.y - g.y)); // where the GS takes it
            if (p.misc.w > 0.0) {
                uv = at;
            } else if (p.mode.x != 3 || p.orig.w != 0.0) {
                // The game's own 2D art, shown smooth (BT3_2D_SMOOTH): the coordinate of this output pixel as it
                // is. The GS shows the texel its whole pixel falls into over the whole GS pixel, so that texel's
                // middle belongs at the GS pixel's middle, which is where the plain coordinate puts it; the
                // filter then blends towards the neighbours on either side. Held inside the piece's own rectangle
                // of the sheet (rect), by the middles of its edge texels, so nothing of the next piece is blended
                // in. (The replacement's rule below, tried here, chooses between two formulas by a derivative
                // for every pixel: on art near one texel a pixel the choice flickered from pixel to pixel, seen as
                // comb-like stripes in small text.)
                // A texture pack's replacement takes this rule too (orig.w, set unless BT3_TEX_GRID=1): the rule below
                // holds the picture to the GS's pixel grid, so a piece that glides by parts of a GS pixel (the main
                // menu's entries) had its letters step one after the other: text that tears while it moves.
                vec2 inset = 0.5 / vec2(textureSize(tex, 0));
                uv = clamp(uv, p.rect.xy + inset, p.rect.zw - inset);
            } else {
                // A texture pack's replacement (several texels per original texel; orig.xy = the original's size,
                // rect = this piece's rectangle of the sheet). o: this output pixel's place inside its GS pixel.
                // Where the piece is drawn one texel per GS pixel (text, HUD), the GS pixel shows the texel `at`
                // falls into, so the output pixel shows the matching part of that texel; otherwise the
                // coordinate is carried on from `at`, half a GS pixel to either side.
                vec2 o = (f - g) / s, step = vec2(dx.x, dy.y) * s * p.orig.xy; // texels per GS pixel
                // (`at` lies ON a texel boundary where a piece has whole-texel coordinates: a 64th of a texel in the
                // piece's direction decides which side, as the piece's rectangle is worked out. Without it the
                // rounding of `at` chose from pixel to pixel: columns of a letter missing, steps along a logo.)
                vec2 snapped = (floor(at * p.orig.xy + sign(step) / 64.0) + mix(1.0 - o, o, step2(step))) / p.orig.xy;
                vec2 carried = at + (o - 0.5) * vec2(dx.x, dy.y) * s;
                bvec2 one = lessThan(abs(abs(step) - 1.0), vec2(0.02));
                uv = vec2(one.x ? snapped.x : carried.x, one.y ? snapped.y : carried.y);
                vec2 inset = 0.5 / vec2(textureSize(tex, 0));
                uv = clamp(uv, p.rect.xy + inset, p.rect.zw - inset);
            }
        }
        if (p.mode.x == 2) uv = clamp(uv, p.rect.xy, p.rect.zw);
#ifdef GS_BLOCK
        vec4 t = p.mode.x == 2 && p.orig.x > 1.5 ? gs_bilinear(uv) : texture(tex, uv);
#else
        vec4 t = texture(tex, uv);
#endif
        // A single continuous mask across the whole large portrait. Artwork
        // atlas pieces and transparent rows share exactly the same edge.
        // Screen coordinates keep the fade smooth even with native texel sampling.
        if (p.extra.w != 0.0)
            portraitFade=smoothstep(0.0,1.0,(gl_FragCoord.x-p.extra.z)/p.extra.w);
        if (p.mode.x == 1 || p.mode.x == 3) t.a *= k; // a texture from GS memory keeps the GS alpha (0x80 opaque, up to 0xFF)
        // A texture pack's replacement. The game does more with a texture's alpha than blend: the alpha it writes
        // into the picture is tested by later draws, bit 7 as a mask (a texture that stays at 0x7F never sets it,
        // one at 0x80 always does). A replacement's alpha is redrawn and compressed: it strays a few steps either
        // way. orig.z = the original's largest alpha (1.0 = 0x80): the replacement never goes above that; and
        // where the original reaches 0x80, just under opaque counts as opaque.
        if (p.mode.x == 3) {
            if (p.orig.z < 1.0) t.a = min(t.a, p.orig.z);
            else if (t.a > 0.93 && t.a < 1.0) t.a = 1.0;
        }
        if (p.mode.y == 0) {
            rgb = t.rgb * vColor.rgb * k;
            if (p.mode.z != 0) a = t.a * a;
        } else if (p.mode.y == 1) {
            rgb = t.rgb;
            if (p.mode.z != 0) a = t.a;
        } else {
            rgb = t.rgb * vColor.rgb * k + vec3(vColor.a);
            if (p.mode.z != 0) a = (p.mode.y == 2) ? t.a + a : t.a;
        }
    }
    if (p.mode.w != 0) {
        // the GS compares integers; round, or a value that is exactly AREF (tree leaves: 0x7F against 0x7F) fails by float error
        float ag = floor(a * 128.0 + 0.5);
        int f = p.mode.w - 1;
        // A texture pack's replacement (mode.x == 3): its alpha is not the exact value the game tests for. The
        // compression moves it by a few steps (0x7F becomes 0x7C..0x7E) and the filtering fades it towards the
        // edge of a cut-out shape, so a test against the exact value drops most of it (trees lost their
        // leaves). There the line is drawn at half the reference: the middle of the fade, where the original
        // shape's edge is.
        float ref = p.mode.x == 3 ? p.misc.x * 0.5 : p.misc.x, tol = p.mode.x == 3 ? max(ref, 0.5) : 0.5;
        bool pass = f == 0 ? false : f == 1 ? true : f == 2 ? ag < ref : f == 3 ? ag <= ref :
                    f == 4 ? abs(ag - p.misc.x) < tol : f == 5 ? ag >= ref : f == 6 ? ag > ref : abs(ag - p.misc.x) >= tol;
        if (!pass) discard;
    }
    // The GS keeps and compares depth as whole numbers. Two surfaces in one plane (a waterfall on its rock, a
    // decal on the ground) then tie and the later one is drawn over the earlier; with fractions kept, one of them
    // wins by a hair, here this triangle and there that one, and it changes as the camera moves. (Not with 32
    // bits: a float has no room for those.)
    // A shader that writes depth costs: the graphics chip can no longer leave out hidden pixels before running it
    // (a quarter of the frame rate on an integrated chip, measured). So only what needs it is drawn with this:
    // see pipeline_get in gs_draw.c for which draws get the variant without (NO_FRAG_DEPTH).
    // The whole number is kept as a float again, and floor(z * steps) / steps, worked out in floats, can come out
    // one last bit ABOVE z itself. A draw without this output (NO_FRAG_DEPTH) is tested with z as it is, so a
    // second layer on the very same triangles then lost "greater or equal" against what the first had written,
    // here and there: white dots on a shiny character (0.1.31 to 0.1.34). So what is written is never above z:
    // where the division came out above, the step below is taken. With that, "z >= what is stored" is the same
    // as "the step of z >= what is stored", which is what the variant without the output relies on.
#ifndef NO_FRAG_DEPTH
    if (p.extra.x > 0.0 && p.extra.x < 2.0e7) {
        float zn = floor(gl_FragCoord.z * p.extra.x), zq = zn / p.extra.x;
        gl_FragDepth = zq > gl_FragCoord.z ? (zn - 1.0) / p.extra.x : zq;
    } else {
        gl_FragDepth = gl_FragCoord.z;
    }
#endif
    a *= portraitFade; // after the original GS alpha test
    if (p.extra.y != 0.0) rgb *= a; // (the GS's factor As / 0x80, which goes up to 2: no blend factor does)
    outColor = vec4(clamp(rgb, 0.0, 1.0), clamp(a, 0.0, 1.0));
    float ab = clamp(a * 128.0 / 255.0, 0.0, 1.0);
    if (p.misc.z != 0.0) ab = (float(int(ab * 255.0 + 0.5) | 128)) / 255.0; // FBA
    outAux = vec4(ab, 0.0, 0.0, 1.0);
}
